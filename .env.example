# Copy to .env.local (local dev / CLI) or set in Vercel → Project → Settings → Environment Variables.
# Server-side only. Never prefix with NEXT_PUBLIC_ and never commit real values.

# Required: Google AI Studio key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# Optional extra keys (GEMINI_API_KEY_2 … _9, or a comma list in GEMINI_API_KEYS). Each model is tried
# on every key before falling back to the next model, so a busy or rate-limited key is skipped.
GEMINI_API_KEY_2=

# Primary model + fallback chain. Attempt 1 uses the first model; an overload (503), rate limit (429)
# or timeout retries on the next one. Every attempt counts toward the 5-call update limit and is traced
# with the model that answered. For the 10-point bonus EVERY model in the chain must be on the
# organizers' small-model list — get that list from the help desk; do not assume a model qualifies.
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemma-4-26b-a4b-it

# Optional: thinking token budget for Gemini 2.5 models. Default 0 for 2.5-flash models
# (no hidden "thinking" tokens = leaner runs). Leave empty to use the model default.
GEMINI_THINKING_BUDGET=

# Optional planner policy (see README "Judges vs meals"):
#   minimum        = engage only the judges the coverage rule needs (default)
#   all_confirmed  = pay and feed every confirmed judge
MTM_JUDGE_POLICY=minimum

# Optional: start time used only when no message states one (24h HH:MM)
MTM_DEFAULT_START=10:00
