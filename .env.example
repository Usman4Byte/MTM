# Copy to .env.local (local dev / CLI) or set in Vercel → Project → Settings → Environment Variables.
# Server-side only. Never prefix with NEXT_PUBLIC_ and never commit real values.

# Required: Google AI Studio key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Model used for EVERY call. For the 10-point bonus it must be on the organizers'
# small-model list — get that list from the help desk; do not assume a model qualifies.
GEMINI_MODEL=gemini-2.5-flash-lite

# Optional: thinking token budget for Gemini 2.5 models. Default 0 for 2.5-flash models
# (no hidden "thinking" tokens = leaner runs). Leave empty to use the model default.
GEMINI_THINKING_BUDGET=

# Optional planner policy (see README "Judges vs meals"):
#   minimum        = engage only the judges the coverage rule needs (default)
#   all_confirmed  = pay and feed every confirmed judge
MTM_JUDGE_POLICY=minimum

# Optional: start time used only when no message states one (24h HH:MM)
MTM_DEFAULT_START=10:00
